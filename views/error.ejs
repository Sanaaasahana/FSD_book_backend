<!DOCTYPE html>
<html>
<head>
    <title>Error</title>
    <link rel="stylesheet" href="/styles/main.css">
</head>
<body>
    <div class="error-container">
        <h1>Error</h1>
        <div class="error-message">
            <p><%= error %></p>
            <% if (message) { %>
                <p><%= message %></p>
            <% } %>
        </div>
        <a href="/" class="home-link">Return to Home</a>
    </div>
</body>
</html>
