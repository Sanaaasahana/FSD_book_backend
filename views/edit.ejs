<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Book | Book Notes</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles/edit.css">
</head>
<body>
    <div class="edit-container">
        <div class="edit-header">
            <h1>Edit Book Details</h1>
            <p class="subtitle">Update your book information below</p>
        </div>

        <% if (error) { %>
            <div class="error-message">
                <p><%= error %></p>
            </div>
        <% } %>

        <form class="edit-form" action="/update" method="post">
            <input type="hidden" name="id" value="<%= bookToEdit.id %>">
            
            <div class="form-group">
                <label for="updatedTitle">Title</label>
                <input type="text" name="updatedTitle" id="updatedTitle" value="<%= bookToEdit.title %>" placeholder="Enter book title" required>
                <div class="focus-border"></div>
            </div>

            <div class="form-group">
                <label for="updatedDescription">Description</label>
                <textarea name="updatedDescription" id="updatedDescription" rows="5" placeholder="Enter book description"><%= bookToEdit.description %></textarea>
                <div class="focus-border"></div>
            </div>

            <div class="form-group">
                <label for="updatedRating">Rating (0-5)</label>
                <input type="number" name="updatedRating" id="updatedRating" min="0" max="5" step="0.1" value="<%= bookToEdit.rating %>" placeholder="Enter rating">
                <div class="focus-border"></div>
            </div>

            <div class="form-group">
                <label for="updatedCategory">Category</label>
                <select name="updatedCategory" id="updatedCategory">
                    <option value="">Select Category</option>
                    <% if (categories && categories.length) { %>
                        <% categories.forEach(category => { %>
                            <option value="<%= category.id %>" <%= bookToEdit.category_id === category.id ? 'selected' : '' %>>
                                <%= category.name %>
                            </option>
                        <% }); %>
                    <% } %>
                </select>
                <div class="focus-border"></div>
            </div>

            <div class="form-actions">
                <button type="submit" class="update-btn">
                    <span>Update Book</span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 6L9 17l-5-5"/>
                    </svg>
                </button>
                <a href="/" class="cancel-btn">Cancel</a>
            </div>
        </form>
    </div>

    <script>
        // Basic client-side validation
        document.querySelector('.edit-form').addEventListener('submit', function(e) {
            const title = document.getElementById('updatedTitle').value.trim();
            const rating = document.getElementById('updatedRating').value;
            
            if (!title) {
                e.preventDefault();
                alert('Title is required');
                document.getElementById('updatedTitle').focus();
                return;
            }
            
            if (rating && (rating < 0 || rating > 5)) {
                e.preventDefault();
                alert('Rating must be between 0 and 5');
                document.getElementById('updatedRating').focus();
                return;
            }
        });
    </script>
</body>
</html>
